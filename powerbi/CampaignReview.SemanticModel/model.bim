        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ],
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "DataFolder",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ],
        "expression": "\"C:/path/to/marketing-campaign-performance/data/processed\" meta [IsParameterQuery=true,Type=\"Text\",IsParameterQueryRequired=true]",
        "kind": "m",
        "lineageTag": "1859468d-1dc1-4070-a2a0-bcc135b0731c"
      }
    ],
    "relationships": [
      {
        "name": "Campaigns_Months",
