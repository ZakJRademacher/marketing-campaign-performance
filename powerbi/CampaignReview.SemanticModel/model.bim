          },
          {
            "name": "Contact Band",
            "dataType": "string",
            "lineageTag": "78685b05-f3dc-412e-9029-ac16a70f821d",
            "sourceColumn": "Contact Band",
            "summarizeBy": "none"
          },
          {
            "name": "Subscribed",
            "dataType": "int64",
            "lineageTag": "eb60b351-09bb-4378-a46a-2442a9e4ef5f",
            "sourceColumn": "Subscribed",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "fb8ce34e-7eab-4f65-ba24-0be56d9ea574",
        "measures": [
          {
            "name": "Records",
            "expression": "COUNTROWS('Campaigns')",
            "formatString": "#,0",
            "lineageTag": "10a8bda9-f739-476f-bbef-edddcf7398f1"
          },
          {
            "name": "Subscriptions",
            "expression": "SUM('Campaigns'[Subscribed])",
            "formatString": "#,0",
            "lineageTag": "1d57ca58-3646-4d9b-bcab-92be1a171a62"
          },
          {
            "name": "Subscription Rate",
            "expression": "DIVIDE([Subscriptions],[Records])",
            "formatString": "0.0%",
            "lineageTag": "bb1730ba-f306-4c31-bc5f-b9f670361851"
          },
          {
            "name": "Recorded Contacts",
            "expression": "SUM('Campaigns'[Contacts])",
            "formatString": "#,0",
            "lineageTag": "f4be3da1-024b-4fd5-84f9-5733552acda6"
          },
          {
            "name": "Contacts per Record",
            "expression": "DIVIDE([Recorded Contacts],[Records])",
            "formatString": "0.00",
            "lineageTag": "e93c6da7-1ac8-4e3c-884d-c7665bf9f5c2"
          },
          {
            "name": "Subscriptions per 100 Contacts",
            "expression": "100 * DIVIDE([Subscriptions],[Recorded Contacts])",
            "formatString": "0.00",
            "lineageTag": "1d9810e9-6b74-4b63-b264-31deb2af94e6"
          },
          {
            "name": "Group Size",
            "expression": "IF([Records] < 100, \"Small sample: N < 100\", \"N >= 100; descriptive comparison\")",
            "lineageTag": "8d0fcde2-ded8-45a7-b46b-4976f0c37890"
          },
          {
            "name": "Selection Finding",
            "expression": "VAR N=[Records] RETURN IF(ISBLANK(N), \"No records match this selection.\", FORMAT(N,\"#,0\") & \" records; \" & FORMAT([Subscriptions],\"#,0\") & \" subscriptions (\" & FORMAT([Subscription Rate],\"0.0%\") & \"). Recorded contacts: \" & FORMAT([Recorded Contacts],\"#,0\") & \". Compare like months and channels before choosing a trial.\")",
            "lineageTag": "32194a57-1fa5-49cc-bb95-42ca76c880ae"
          }
        ],
        "partitions": [
          {
            "name": "Campaigns",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataFolder & \"/Campaigns.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers, {{\"Source Row\", Int64.Type}, {\"Month\", type text}, {\"Month Order\", Int64.Type}, {\"Channel\", type text}, {\"Previous Outcome\", type text}, {\"Contacts\", Int64.Type}, {\"Contact Band\", type text}, {\"Subscribed\", Int64.Type}}, \"en-US\")",
                "in",
                " Typed"
              ],
              "type": "m"
            }
          }
        ]
