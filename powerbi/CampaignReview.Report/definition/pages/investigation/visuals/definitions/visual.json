    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "READ THE MEASURES",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#EAF0FC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "One record is one source client-campaign observation, not a phone-call event. Recorded contacts sum campaign contact counts, including the last contact. Rates divide observed subscriptions by records in the same selection. Source row numbers provide lineage, not reusable customer identities.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#EAF0FC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#EAF0FC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "WHY THIS IS NOT A STOPPING RULE",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#EAF0FC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Nonresponders may receive more attempts; final contact count is partly a result of the process. Call duration is post-contact and excluded. The source lacks costs and a randomized untreated group. Do not infer ROI, incremental lift or a causal effect of contact frequency.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#EAF0FC"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
